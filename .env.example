# ---------------------------------------------------------------
# Zivo environment variables
# Copy this file to ".env.local" and fill in your own values.
# NEVER commit .env.local — it is already in .gitignore.
# See SETUP.md for where to find each value.
# ---------------------------------------------------------------

# Your site's public URL (no trailing slash).
# Local: http://localhost:3000   Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API / API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key — safe to use in the browser (RLS protects your data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# The "service_role" / "secret" key — SERVER ONLY. Never share it or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# --- Razorpay (Dashboard -> Account & Settings -> API Keys) ---
# Key ID is public (it's shown in the checkout popup). Starts with rzp_test_ or rzp_live_.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Key secret — SERVER ONLY.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# The secret you type when creating the webhook (Dashboard -> Webhooks) — SERVER ONLY.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Resend (resend.com -> API Keys) ---
# SERVER ONLY.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender shown on order emails. Until you verify a domain in Resend, use onboarding@resend.dev
# (test mode can only deliver to the email address of your Resend account).
EMAIL_FROM=Zivo <onboarding@resend.dev>
